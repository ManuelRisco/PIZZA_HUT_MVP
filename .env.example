# =====================================================
# 1. CONFIGURACIÓN DE BASE DE DATOS (SQL SERVER / MYSQL)
# =====================================================
# SQL Server (Principal):
DB_URL=jdbc:sqlserver://localhost:1433;databaseName=pizzahut_bd;encrypt=true;trustServerCertificate=true;
DB_USERNAME=pizzahut_user
DB_PASSWORD=tu_password_aqui

# Alternativa MySQL 8.0:
# DB_URL=jdbc:mysql://localhost:3306/pizzahut_bd?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC

# =====================================================
# 2. JWT Y SEGURIDAD
# =====================================================
JWT_SECRET=tu_jwt_secret_hs512_minimo_64_caracteres_aqui
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=86400000

# =====================================================
# 3. CONFIGURACIÓN DE CORREO GMAIL (SMTP TLS 587)
# =====================================================
MAIL_ENABLED=true
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=tu_correo@gmail.com
MAIL_PASSWORD=tu_app_password_16_caracteres
MAIL_FROM=tu_correo@gmail.com

# Consolidación de alertas de stock en ventana de 1 minuto (60s)
STOCK_ALERTS_POLL_ENABLED=true
STOCK_ALERTS_POLL_MS=5000
STOCK_ALERTS_BATCH_WINDOW_SECONDS=60

# =====================================================
# 4. GOOGLE OAUTH2 (GOOGLE IDENTITY SERVICES)
# =====================================================
GOOGLE_CLIENT_ID=tu_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu_google_client_secret
GOOGLE_ALLOW_DEV_MODE=false

# =====================================================
# 5. PROTECCIÓN ANTI-DDOS (RATE LIMITING POR IP)
# =====================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=15
RATE_LIMIT_WRITE_PER_MINUTE=60
RATE_LIMIT_GENERAL_PER_MINUTE=240

# =====================================================
# 6. CONSULTA DNI RENIEC (DECOLECTA) Y BOLETAS SUNAT (NUBEFACT)
# =====================================================
decolecta.api.url=https://api.decolecta.com/v1
decolecta.api.token=tu_token_decolecta_aqui
nubefact.api.url=https://api.nubefact.com/api/v1/tu_ruta_nubefact_aqui
nubefact.api.token=tu_token_nubefact_aqui
